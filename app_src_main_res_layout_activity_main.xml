<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF" android:padding="16dp">
<TextView android:text="MCB VPN" android:textSize="22sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="MCB VPN" android:textSize="60sp" android:textStyle="bold" android:gravity="center" android:textColor="#FF6A00" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"/>
<Switch android:id="@+id/toggle" android:layout_gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:scaleX="2.0" android:scaleY="2.0" android:layout_marginTop="20dp" android:layout_marginBottom="16dp"/>
<TextView android:id="@+id/statusText" android:text="Disconnected" android:textSize="20sp" android:textStyle="bold" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Your DNS queries are private and faster." android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Spinner android:id="@+id/serverSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
<TextView android:id="@+id/infoBox" android:text="📶 Ping: -- • Disconnected" android:background="#F5F5F5" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
<Button android:id="@+id/speedBtn" android:text="⚡ TEST SPEED NOW" android:backgroundTint="#FF6A00" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
<Button android:id="@+id/menuBtn" android:text="☰ MENU - Settings / Account / Devices / Share" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
</LinearLayout>